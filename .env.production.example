# ==============================================================================
# ENVIRONMENT VARIABLES FOR ISOLATED VPS DEPLOYMENT
# ==============================================================================

# Loopback port on the host where Mahi API listens
# Choose any unused port (default: 4080)
MAHI_API_PORT=4080

# Isolated Database credentials (internal only, not exposed on host)
MAHI_DB_USER=mahi_user
MAHI_DB_PASSWORD=change_this_to_a_secure_generated_password
MAHI_DB_NAME=mahi_downloader

# JWT signing secret (generate with: openssl rand -hex 32)
MAHI_JWT_SECRET=change_this_to_a_secure_jwt_secret

# Frontend origin allowed to make CORS requests (e.g. your Cloudflare Pages or custom domain)
MAHI_FRONTEND_ORIGIN=*
